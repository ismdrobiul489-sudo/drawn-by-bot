# ─────────────────────────────────────────────────────────────────────────────
# drawn-by-bot — ALL configuration lives in this file.
# Copy to ".env", fill in your own values, NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ────────────────────────────────────────────────────────────────
# Token of the NEW bot you create with @BotFather (do NOT reuse any other bot).
TELEGRAM_BOT_TOKEN=
# Bot API base. Default is Telegram's cloud API. If you later run a self-hosted
# telegram-bot-api server (raises the upload limit from 50 MB to 2 GB), point
# this at it, e.g. http://127.0.0.1:8081
TELEGRAM_API_BASE=https://api.telegram.org
# Your own numeric Telegram user id — the bot ignores everyone else.
OWNER_TELEGRAM_ID=

# ── LLM providers (both stay; the bot's current model picks between them) ──
GROQ_API_KEY=
# Groq base URL (OpenAI-compatible). Models are fetched LIVE from /models.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Groq's starting current model — every job uses the current model until
# the owner changes it in the bot with /model.
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Vision model used by the contact-sheet QC tool (must be a vision model that
# is actually provisioned on your key).
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# Provider of the starting current model: groq | nvidia. Together with
# that provider's *_DEFAULT_MODEL above it is the selection every job
# uses — jobs never ask. Change it later only in the bot, with /model.
DEFAULT_PROVIDER=nvidia
# Before a job starts, the current model is verified with a 1-token API
# probe; a dead model falls back automatically to this provider's default
# model above, then to the other provider's default — with a Telegram
# notice, never silence. MODEL_PROBE=off disables the probe.
MODEL_PROBE=on
# Seconds one probe waits for an answer before calling the model dead
# (NVIDIA cold starts are slow — don't lower this much below 45).
PROBE_TIMEOUT_SEC=45
# How long a fetched /models list is cached, in seconds.
MODELS_CACHE_TTL_SEC=900

# ── Whisper (transcription / SRT) ───────────────────────────────────────────
WHISPER_MODEL=whisper-large-v3

# ── Edge TTS ────────────────────────────────────────────────────────────────
# Path to the edge-tts binary (installed by deploy/setup.sh via pip).
EDGE_TTS_BIN=edge-tts
# Voice pre-selected in the bot's voice step (live list is still shown).
EDGE_TTS_DEFAULT_VOICE=en-US-AriaNeural
# Takes per voice section: 1 (default) or 2. With 2, every section is also
# synthesized once more with a small pitch shift — a synthesis-time setting
# only; recorded audio is never stretched or re-pitched afterwards, and the
# speed always stays 100. The listener QC (below) picks the better take
# per section.
TTS_TAKES=1

# ── Voice listener QC (automatic after TTS in topic/script jobs) ────────────
# Silences in the finished voice at least this long (seconds) are flagged.
# Normal between-sentence pauses (~0.3 s) stay far below it.
QC_SILENCE_SEC=1.2
# The QC also re-transcribes the voice with Whisper and word-diffs it
# against the script — but only when the total audio (ALL takes included)
# is at most this many seconds, to protect the Groq free quota. Longer
# jobs get the silence check only, and the report says so.
QC_WHISPER_MAX_SEC=1200

# ── OpenCode (the agent driver) ─────────────────────────────────────────────
OPENCODE_BIN=opencode
# Driver: "serve" runs one long-lived `opencode serve` process, keeps ONE
# persistent conversation session per chat, and relays the agent's
# permission requests + questions to Telegram as buttons. It is the only
# driver — the old one-shot "run" fallback no longer exists.
# Port of the bot-managed `opencode serve` process (localhost only).
OPENCODE_PORT=4096
# Optional: use an already-running OpenCode server instead of spawning one,
# e.g. http://127.0.0.1:4096 (then OPENCODE_PORT is ignored).
OPENCODE_SERVER_URL=
# Minutes before an unanswered permission/question gets ONE reminder nudge.
# Nothing is ever auto-approved — the job simply stays paused.
ASK_REMIND_MIN=30
# Model the OpenCode session uses when the job's provider has no mapping here.
# Format: provider/model, e.g. groq/openai/gpt-oss-120b or nvidia/<model-id>.
# The bot overrides this per turn with the current selection (see
# DEFAULT_PROVIDER / *_DEFAULT_MODEL; changed in the bot only via /model).
OPENCODE_DEFAULT_MODEL=groq/openai/gpt-oss-120b
# Safety cap on waiting for ONE agent turn's reply, in minutes. Normal
# turns finish in seconds-to-minutes; long video work happens through
# the agent's own tool calls inside the turn.
OPENCODE_TIMEOUT_MIN=120
# Turn watchdog: if an agent turn shows NO activity for this many
# minutes, the model is treated as stopped answering — the turn is
# aborted and the owner gets a message naming the model (never silence).
# Fractional values allowed (0.05 = 3 s — used by the tests). While the
# agent waits on a permission/question answer, the turn is waiting on
# YOU, not the model, and the watchdog stays out of it.
TURN_STALL_MIN=3
# Absolute cap on ONE turn, in minutes — same handling as the watchdog
# above when a turn runs this long without finishing.
TURN_MAX_MIN=15
# How often (seconds) the bot re-checks the agent server for pending
# permission/question asks, as a backstop for the event stream.
ASK_POLL_SEC=7
# If the agent event stream delivers nothing for this many seconds
# while a turn is running, it is treated as silently dead and is
# reconnected automatically.
SSE_STALE_SEC=90
# When the provider answers a turn with a transient overload (HTTP 503
# / service_unavailable), the bot waits this many seconds and retries
# the same turn once, with a notice to the owner. No model switch.
TRANSIENT_RETRY_DELAY_SEC=20
# Path to Chrome/Chromium for the engine's renders. Leave empty when
# Chromium sits in a standard path (/usr/bin/chromium etc.) — the engine
# finds it by itself. Set only if renders report "Chrome/Chromium not found".
CHROME_PATH=

# ── Delivery / store ────────────────────────────────────────────────────────
# Max MB for a video sent directly into Telegram (bot API limit is 50 MB).
TELEGRAM_MAX_MB=48
# Public base URL of this bot's built-in file server, e.g. https://bot.example.com
# The store link sent to Telegram is PUBLIC_BASE_URL/files/<token>/<file>.
PUBLIC_BASE_URL=
# Port of the built-in store HTTP server (also used for health checks).
STORE_PORT=8090
# Days to keep stored masters before rotation deletes them.
STORE_KEEP_DAYS=30
